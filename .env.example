# Salin file ini jadi .env lalu isi sesuai kebutuhan.
# .env sudah masuk .gitignore, jadi aman tidak ikut ter-commit.

# Domain situs Rout. Dipakai untuk URL absolut pada tag hreflang dan canonical.
# Defaultnya http://localhost:3000, jadi selama variabel ini belum diisi
# tag SEO akan menunjuk ke localhost.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Sumber data acara Running Man. Tidak dibaca kode mana pun — hanya
# catatan di mana datanya harus dicari kalau perlu diperbarui.
# Penjelasan lengkap ada di AGENTS.md, bagian "Sumber data Running Man".
#
#   Isi profil cast — nama, sapaan, deskripsi, karier, foto
#   https://m.programs.sbs.co.kr/enter/runningman/cast/67779
#
#   Judul acara resmi dan nama jaringan
#   https://sbs.co.kr
#
#   Status anggota terkini — siapa yang masih aktif
#   https://m.naver.com
#
# URL pencarian Naver yang bisa langsung dibuka, urutan terbaru lebih dulu:
#   https://search.naver.com/search.naver?where=news&sort=1&query=런닝맨+출연진
#   https://search.naver.com/search.naver?where=news&sort=1&query=지예은+런닝맨
#
# Data 지예은 sendiri berasal dari Wikipedia Korea, karena SBS tidak
# mencantumkannya sama sekali:
#   https://ko.wikipedia.org/wiki/지예은
#
# Perhatikan: halaman cast SBS tidak pernah diperbarui. 지예은 tidak ada
# di sana, dan 이광수 serta 전소민 masih tercantum padahal sudah keluar.
# Karena itu status diambil dari Naver, bukan dari SBS.